# Comma-separated list of emails allowed into the admin dashboard
# (src/routes/admin/). Checked only inside functions/src/index.ts's
# requireAdmin() — never shipped to the client bundle. Copy this file to
# .env (gitignored) and fill in real values.
ADMIN_EMAILS=you@example.com,researcher2@example.com

# For a test-only admin account (e.g. a fake Google account from the Auth
# Emulator's sign-in chooser) that should NEVER have admin access in
# production, put it in functions/.env.local instead of .env — Firebase
# Functions loads .env.local only for `firebase emulators:start`/`npm run
# emu`, and `firebase deploy` skips it entirely.
