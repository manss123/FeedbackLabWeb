rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['assessmentResults', 'certificate']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assessmentResults', 'certificate']);
      allow delete: if false;
      match /assessment_attempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Validated and scored by submitRankingAssessment only.
      }
      // Post-experiment questionnaire responses — unlike assessment_attempts,
      // written directly by the client (no scored answer key to protect here),
      // but still create-only: once submitted, a research response is
      // immutable, same as activity_log.
      match /questionnaire_responses/{responseId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    match /scenarios/{scenarioId} {
      allow read: if request.auth != null;
      allow write: if false; // scenario content is managed server-side only
    }

    match /sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Milestone activity log — an immutable audit trail (unlike sessions,
    // no update/delete: an event, once logged, never changes). Admin reads
    // go through the Cloud Function's Admin SDK, which bypasses these rules
    // entirely — see functions/src/index.ts's adminGetUserActivity.
    match /activity_log/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }
  }
}
